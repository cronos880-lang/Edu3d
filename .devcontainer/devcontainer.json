{
  "name": "Edu3d · CAD personal",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "remoteUser": "vscode",
  "containerUser": "vscode",
  "updateRemoteUserUID": true,
  "postCreateCommand": "bash scripts/setup.sh && .venv/bin/python -m pytest -q",
  "postStartCommand": "bash scripts/codespaces-start.sh",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Edu3d · aplicación completa",
      "onAutoForward": "openBrowser",
      "protocol": "http"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
